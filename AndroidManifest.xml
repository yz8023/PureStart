<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.yz8023.purestart"
    android:versionCode="116"
    android:versionName="15.1.7">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />
    <!-- 权限面收窄（按外部分析报告 P2）：
         · 移除 INTERNET：模块自身无任何网络请求（反馈按钮走浏览器 ACTION_VIEW）；
         · 移除 QUERY_ALL_PACKAGES：改用下方 <queries> 精确声明 17 个目标包，
           设置页只逐包查询目标（不再全量枚举）。 -->
    <!-- 系统壁纸：Android 14+ 只有持有「所有文件访问」的应用才能读到桌面壁纸
         （WallpaperManager.getDrawable 官方文档；Google 标记 Won't Fix）。
         权限仅在用户主动选择「系统壁纸」时通过系统设置页授予，模块本身不主动申请、
         不用于读写用户文件；不授予则自动提示并建议改用自定义图片。
         参考实现：yz8023/UI 素材库/网络壁纸与离线缓存/代码/SystemWallpaper.kt -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- Android 12 及以下读系统壁纸需要该权限；13+ 由上面的「所有文件访问」覆盖 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <queries>
        <package android:name="com.realtech.xiaocan" />
        <package android:name="com.netease.cloudmusic" />
        <package android:name="com.luna.music" />
        <package android:name="com.xiaomi.shop" />
        <package android:name="com.yek.android.kfc.activitys" />
        <package android:name="com.mcdonalds.gma.cn" />
        <package android:name="com.tencent.qqmusic" />
        <package android:name="com.coolapk.market" />
        <package android:name="com.baidu.BaiduMap" />
        <package android:name="com.xiaomi.market" />
        <package android:name="com.glodon.drawingexplorer" />
        <package android:name="com.xbxxhz.box" />
        <package android:name="tv.danmaku.bili" />
        <package android:name="com.autonavi.minimap" />
        <package android:name="com.zhihu.android" />
        <package android:name="com.dragon.read" />
        <package android:name="com.baidu.netdisk" />
    </queries>

    <application
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="PureStart"
        android:description="@string/moddesc"
        android:forceQueryable="true">

        <!-- The settings Activity stays available separately from the launcher alias.
             MODULE_SETTINGS follows the WeKit discovery pattern for Xposed managers. -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="PureStart"
            android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <action android:name="android.intent.action.APPLICATION_PREFERENCES" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>

        <!-- 桌面图标恢复通道：隐藏图标后 adb 广播可恢复（IconControlReceiver） -->
        <receiver
            android:name=".IconControlReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.yz8023.purestart.action.SHOW_ICON" />
            </intent-filter>
        </receiver>

        <!-- 桌面图标开关：禁用/启用此 alias 即隐藏/恢复桌面图标（设置页内实时切换） -->
        <activity-alias
            android:name=".IconAlias"
            android:targetActivity=".SettingsActivity"
            android:exported="true"
            android:label="PureStart"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Hook 开关查询入口：目标应用进程内经 call() 读取设置页勾选状态；
             exported + 应用级 forceQueryable 保证 FPA/LSPatch/LSPosed 下均可达 -->
        <provider
            android:name=".HookStateProvider"
            android:authorities="com.yz8023.purestart.hookstate"
            android:exported="true" />
    </application>
</manifest>